<?xml version="1.0"?>
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">softaware_activitylog_login_listing.softaware_activitylog_login_listing_data_source</item>
        </item>
    </argument>
    <settings>
        <spinner>softaware_activitylog_login_columns</spinner>
        <deps>
            <dep>softaware_activitylog_login_listing.softaware_activitylog_login_listing_data_source</dep>
        </deps>
    </settings>
    <dataSource name="softaware_activitylog_login_listing_data_source" component="Magento_Ui/js/grid/provider">
        <settings>
            <storageConfig>
                <param name="indexField" xsi:type="string">login_id</param>
            </storageConfig>
            <updateUrl path="mui/index/render"/>
        </settings>
        <aclResource>Softaware_ActivityLog::logins</aclResource>
        <dataProvider class="Magento\Framework\View\Element\UiComponent\DataProvider\DataProvider" name="softaware_activitylog_login_listing_data_source">
            <settings>
                <requestFieldName>id</requestFieldName>
                <primaryFieldName>login_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <listingToolbar name="listing_top">
        <settings>
            <sticky>true</sticky>
        </settings>
        <bookmark name="bookmarks"/>
        <columnsControls name="columns_controls"/>
        <exportButton name="export_button"/>
        <filterSearch name="fulltext"/>
        <filters name="listing_filters" component="Softaware_ActivityLog/js/grid/filters"/>
        <paging name="listing_paging"/>
    </listingToolbar>
    <columns name="softaware_activitylog_login_columns" component="Softaware_ActivityLog/js/grid/listing" template="Softaware_ActivityLog/grid/listing">
        <column name="login_id" sortOrder="10">
            <settings>
                <filter>textRange</filter>
                <label translate="true">ID</label>
                <sorting>desc</sorting>
            </settings>
        </column>
        <column name="created_at" class="Magento\Ui\Component\Listing\Columns\Date" component="Magento_Ui/js/grid/columns/date" sortOrder="20">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">Time</label>
            </settings>
        </column>
        <column name="username" sortOrder="30">
            <settings>
                <fieldClass>
                    <class name="softaware-activitylog-wrap">true</class>
                </fieldClass>
                <filter>text</filter>
                <label translate="true">Username</label>
            </settings>
        </column>
        <column name="status" class="Softaware\ActivityLog\Ui\Component\Listing\Column\SeverityBadge" component="Magento_Ui/js/grid/columns/column" sortOrder="40">
            <argument name="data" xsi:type="array">
                <item name="severities" xsi:type="array">
                    <item name="success" xsi:type="string">notice</item>
                    <item name="failure" xsi:type="string">minor</item>
                    <item name="locked" xsi:type="string">major</item>
                    <item name="blocked" xsi:type="string">critical</item>
                </item>
            </argument>
            <settings>
                <options class="Softaware\ActivityLog\Model\Source\LoginStatus"/>
                <fieldClass>
                    <class name="softaware-activitylog-badge">true</class>
                </fieldClass>
                <filter>select</filter>
                <dataType>select</dataType>
                <bodyTmpl>ui/grid/cells/html</bodyTmpl>
                <label translate="true">Action</label>
            </settings>
        </column>
        <column name="reason" sortOrder="50">
            <settings>
                <fieldClass>
                    <class name="softaware-activitylog-wrap">true</class>
                </fieldClass>
                <filter>text</filter>
                <label translate="true">Reason</label>
            </settings>
        </column>
        <column name="ip" sortOrder="60">
            <settings>
                <filter>text</filter>
                <label translate="true">IP Address</label>
            </settings>
        </column>
        <column name="country" sortOrder="70">
            <settings>
                <filter>text</filter>
                <label translate="true">Country</label>
            </settings>
        </column>
        <column name="user_agent" sortOrder="80">
            <settings>
                <fieldClass>
                    <class name="softaware-activitylog-wrap">true</class>
                </fieldClass>
                <filter>text</filter>
                <label translate="true">Browser (User Agent)</label>
            </settings>
        </column>
    </columns>
</listing>
