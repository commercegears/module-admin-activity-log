<?xml version="1.0"?>
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">softaware_activitylog_log_listing.softaware_activitylog_log_listing_data_source</item>
        </item>
    </argument>
    <settings>
        <spinner>softaware_activitylog_log_columns</spinner>
        <deps>
            <dep>softaware_activitylog_log_listing.softaware_activitylog_log_listing_data_source</dep>
        </deps>
    </settings>
    <dataSource name="softaware_activitylog_log_listing_data_source" component="Magento_Ui/js/grid/provider">
        <settings>
            <storageConfig>
                <param name="indexField" xsi:type="string">log_id</param>
            </storageConfig>
            <updateUrl path="mui/index/render"/>
        </settings>
        <aclResource>Softaware_ActivityLog::actions</aclResource>
        <dataProvider class="Magento\Framework\View\Element\UiComponent\DataProvider\DataProvider" name="softaware_activitylog_log_listing_data_source">
            <settings>
                <requestFieldName>id</requestFieldName>
                <primaryFieldName>log_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <listingToolbar name="listing_top">
        <settings>
            <sticky>true</sticky>
        </settings>
        <bookmark name="bookmarks"/>
        <columnsControls name="columns_controls"/>
        <exportButton name="export_button"/>
        <filterSearch name="fulltext"/>
        <filters name="listing_filters" component="Softaware_ActivityLog/js/grid/filters"/>
        <paging name="listing_paging"/>
    </listingToolbar>
    <columns name="softaware_activitylog_log_columns" component="Softaware_ActivityLog/js/grid/listing" template="Softaware_ActivityLog/grid/listing">
        <column name="log_id" sortOrder="10">
            <settings>
                <filter>textRange</filter>
                <label translate="true">ID</label>
                <sorting>desc</sorting>
            </settings>
        </column>
        <column name="created_at" class="Magento\Ui\Component\Listing\Columns\Date" component="Magento_Ui/js/grid/columns/date" sortOrder="20">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">Time</label>
            </settings>
        </column>
        <column name="username" class="Softaware\ActivityLog\Ui\Component\Listing\Column\AdminUser" sortOrder="30">
            <settings>
                <filter>text</filter>
                <label translate="true">Admin User</label>
            </settings>
        </column>
        <column name="action" component="Magento_Ui/js/grid/columns/select" sortOrder="40">
            <settings>
                <options class="Softaware\ActivityLog\Model\Source\Action"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Action</label>
            </settings>
        </column>
        <column name="entity_type" component="Magento_Ui/js/grid/columns/select" sortOrder="50">
            <settings>
                <options class="Softaware\ActivityLog\Model\Source\EntityType"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Entity Type</label>
            </settings>
        </column>
        <column name="entity_id" sortOrder="60">
            <settings>
                <filter>text</filter>
                <label translate="true">Entity ID</label>
                <visible>false</visible>
            </settings>
        </column>
        <column name="entity_label" sortOrder="70">
            <settings>
                <fieldClass>
                    <class name="softaware-activitylog-wrap">true</class>
                </fieldClass>
                <filter>text</filter>
                <label translate="true">Entity</label>
            </settings>
        </column>
        <column name="changes_count" sortOrder="80">
            <settings>
                <filter>textRange</filter>
                <label translate="true">Changed Fields</label>
            </settings>
        </column>
        <column name="scope" sortOrder="90">
            <settings>
                <filter>text</filter>
                <label translate="true">Scope</label>
                <visible>false</visible>
            </settings>
        </column>
        <column name="ip" sortOrder="100">
            <settings>
                <filter>text</filter>
                <label translate="true">IP Address</label>
            </settings>
        </column>
        <column name="request_path" sortOrder="110">
            <settings>
                <fieldClass>
                    <class name="softaware-activitylog-wrap">true</class>
                </fieldClass>
                <filter>text</filter>
                <label translate="true">Admin Page</label>
                <visible>false</visible>
            </settings>
        </column>
        <column name="request_id" sortOrder="120">
            <settings>
                <filter>text</filter>
                <label translate="true">Request ID</label>
                <visible>false</visible>
            </settings>
        </column>
        <actionsColumn name="actions" class="Softaware\ActivityLog\Ui\Component\Listing\Column\LogActions" sortOrder="200">
            <settings>
                <indexField>log_id</indexField>
                <label translate="true">Details</label>
            </settings>
        </actionsColumn>
    </columns>
</listing>
