<?php
/**
 * Softaware Admin Activity Log
 *
 * @var \Softaware\ActivityLog\Block\Adminhtml\Log\View $block
 * @var \Magento\Framework\Escaper $escaper
 */
$entry = $block->getEntry();
if (!$entry) {
    return;
}
$changes = $entry->getChangeList();
$isDiff = $block->isDiff($entry, $changes);
$entityUrl = $block->getEntityUrl($entry);
$configUrl = $block->getConfigUrl($entry);
$related = $block->getRelatedEntries($entry);
$relatedCount = $related ? $block->getRelatedCount($entry) : 0;
$renderValue = static function (string $value) use ($escaper): string {
    if ($value === '') {
        return '<span class="softaware-activitylog-empty">' . $escaper->escapeHtml(__('(empty)')) . '</span>';
    }
    // Long values scroll inside the cell; make them reachable by keyboard.
    $focusable = strlen($value) > 400 ? ' tabindex="0"' : '';
    return '<div class="softaware-activitylog-value"' . $focusable . '>' . $escaper->escapeHtml($value) . '</div>';
};
?>
<div class="softaware-activitylog-view">
    <section class="admin__page-section">
        <div class="admin__page-section-title"><span class="title"><?= $escaper->escapeHtml(__('Summary')) ?></span></div>
        <div class="softaware-activitylog-summary">
            <table class="admin__table-secondary">
                <tbody>
                <tr>
                    <th scope="row"><?= $escaper->escapeHtml(__('Action')) ?></th>
                    <td><?= $escaper->escapeHtml($block->getActionLabel((string)$entry->getData('action'))) ?></td>
                </tr>
                <tr>
                    <th scope="row"><?= $escaper->escapeHtml(__('Entity')) ?></th>
                    <td>
                        <?= $escaper->escapeHtml($block->getTypeLabel((string)$entry->getData('entity_type'))) ?>
                        <?php $entityId = (string)$entry->getData('entity_id'); ?>
                        <?php if ($entityId !== '' && ctype_digit($entityId)): ?>
                            #<?= $escaper->escapeHtml($entityId) ?>
                        <?php elseif ($entityId !== ''): ?>
                            <code><?= $escaper->escapeHtml($entityId) ?></code>
                        <?php endif; ?>
                        <?php if ($entry->getData('entity_label')): ?>
                            &ndash; <?= $escaper->escapeHtml($entry->getData('entity_label')) ?>
                        <?php endif; ?>
                        <?php if ($entityUrl): ?>
                            <br><a href="<?= $escaper->escapeUrl($entityUrl) ?>"><?= $escaper->escapeHtml(__('Open Record')) ?></a>
                        <?php elseif ($configUrl): ?>
                            <br><a href="<?= $escaper->escapeUrl($configUrl) ?>"><?= $escaper->escapeHtml(__('Open Configuration Section')) ?></a>
                        <?php endif; ?>
                    </td>
                </tr>
                <?php if ($entry->getData('scope')): ?>
                    <tr>
                        <th scope="row"><?= $escaper->escapeHtml(__('Scope')) ?></th>
                        <td><?= $escaper->escapeHtml($entry->getData('scope')) ?></td>
                    </tr>
                <?php endif; ?>
                <tr>
                    <th scope="row"><?= $escaper->escapeHtml(__('Admin Page')) ?></th>
                    <td><code><?= $escaper->escapeHtml($entry->getData('request_path')) ?></code></td>
                </tr>
                </tbody>
            </table>
            <table class="admin__table-secondary">
                <tbody>
                <tr>
                    <th scope="row"><?= $escaper->escapeHtml(__('Time')) ?></th>
                    <td><?= $escaper->escapeHtml($block->formatUtcTime((string)$entry->getData('created_at'))) ?></td>
                </tr>
                <tr>
                    <th scope="row"><?= $escaper->escapeHtml(__('Admin User')) ?></th>
                    <td><?= $escaper->escapeHtml($entry->getData('username') ?: (
                        \Softaware\ActivityLog\Model\RequestContext::isCommandLine((string)$entry->getData('request_path')) ? __('(command line)') : __('(not signed in)')
                    )) ?></td>
                </tr>
                <tr>
                    <th scope="row"><?= $escaper->escapeHtml(__('IP Address')) ?></th>
                    <td><?= $escaper->escapeHtml($entry->getData('ip') ?: __('none')) ?></td>
                </tr>
                <tr>
                    <th scope="row"><?= $escaper->escapeHtml(__('Changed Fields')) ?></th>
                    <td><?= $escaper->escapeHtml($block->formatNumber((int)$entry->getData('changes_count'))) ?></td>
                </tr>
                </tbody>
            </table>
        </div>
    </section>

    <section class="admin__page-section">
        <div class="admin__page-section-title">
            <span class="title"><?= $escaper->escapeHtml($block->getChangesTitle($entry, $isDiff)) ?></span>
        </div>
        <?php if (!$changes): ?>
            <p><?= $escaper->escapeHtml(
                $entry->getData('action') === 'delete'
                    ? __('The record was deleted. Field values are not stored for deletions.')
                    : __('No field changes were recorded.')
            ) ?></p>
        <?php else: ?>
            <table class="data-table admin__table-primary softaware-activitylog-diff<?= $isDiff ? '' : ' softaware-activitylog-values' ?>">
                <thead>
                <tr>
                    <th scope="col" class="softaware-activitylog-field"><?= $escaper->escapeHtml(__('Field')) ?></th>
                    <?php if ($isDiff): ?>
                        <th scope="col"><?= $escaper->escapeHtml(__('Old Value')) ?></th>
                        <th scope="col"><?= $escaper->escapeHtml(__('New Value')) ?></th>
                    <?php else: ?>
                        <th scope="col"><?= $escaper->escapeHtml(__('Value')) ?></th>
                    <?php endif; ?>
                </tr>
                </thead>
                <tbody>
                <?php foreach ($changes as $change): ?>
                    <tr>
                        <td class="softaware-activitylog-field"><code><?= /* @noEscape */ str_replace('/', '/<wbr>', $escaper->escapeHtml((string)($change['field'] ?? ''))) ?></code></td>
                        <?php if ($isDiff): ?>
                            <td class="softaware-activitylog-old"><?= /* @noEscape */ $renderValue((string)($change['old'] ?? '')) ?></td>
                        <?php endif; ?>
                        <td class="softaware-activitylog-new"><?= /* @noEscape */ $renderValue((string)($change['new'] ?? '')) ?></td>
                    </tr>
                <?php endforeach; ?>
                </tbody>
            </table>
        <?php endif; ?>
    </section>

    <?php if ($related): ?>
        <section class="admin__page-section">
            <div class="admin__page-section-title">
                <span class="title"><?= $escaper->escapeHtml(__('Other Changes in the Same Request')) ?></span>
            </div>
            <?php if ($relatedCount > count($related)): ?>
                <p class="softaware-activitylog-note"><?= $escaper->escapeHtml(__(
                    'Showing the first %1 of %2 entries. Search Admin Actions for %3 to see all of them.',
                    $block->formatNumber(count($related)),
                    $block->formatNumber($relatedCount),
                    (string)$entry->getData('request_id')
                )) ?></p>
            <?php endif; ?>
            <table class="data-table admin__table-primary softaware-activitylog-related">
                <thead>
                <tr>
                    <th scope="col"><?= $escaper->escapeHtml(__('ID')) ?></th>
                    <th scope="col"><?= $escaper->escapeHtml(__('Action')) ?></th>
                    <th scope="col"><?= $escaper->escapeHtml(__('Entity')) ?></th>
                    <th scope="col"><?= $escaper->escapeHtml(__('Changed Fields')) ?></th>
                </tr>
                </thead>
                <tbody>
                <?php foreach ($related as $item): ?>
                    <tr>
                        <td><a href="<?= $escaper->escapeUrl($block->getViewUrl((int)$item->getId())) ?>">#<?= (int)$item->getId() ?></a></td>
                        <td><?= $escaper->escapeHtml($block->getActionLabel((string)$item->getData('action'))) ?></td>
                        <td>
                            <?= $escaper->escapeHtml($block->getTypeLabel((string)$item->getData('entity_type'))) ?>
                            <?php if ($item->getData('entity_label')): ?>
                                &ndash; <?= $escaper->escapeHtml($item->getData('entity_label')) ?>
                            <?php endif; ?>
                        </td>
                        <td><?= $escaper->escapeHtml($block->formatNumber((int)$item->getData('changes_count'))) ?></td>
                    </tr>
                <?php endforeach; ?>
                </tbody>
            </table>
        </section>
    <?php endif; ?>
</div>
