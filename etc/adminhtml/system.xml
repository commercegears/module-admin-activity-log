<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="commercegears_activitylog" translate="label" sortOrder="40" showInDefault="1" showInWebsite="0" showInStore="0">
            <class>separator-top</class>
            <label>Admin Activity Log</label>
            <tab>commercegears</tab>
            <resource>CommerceGears_ActivityLog::config</resource>
            <group id="general" translate="label" sortOrder="10" showInDefault="1">
                <attribute type="expanded">1</attribute>
                <label>General</label>
                <field id="enabled" translate="label comment" type="select" sortOrder="10" showInDefault="1" canRestore="1">
                    <label>Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>When off, nothing is logged, no alerts are sent and the IP allowlist is not enforced.</comment>
                </field>
                <field id="log_actions" translate="label comment" type="select" sortOrder="20" showInDefault="1" canRestore="1">
                    <label>Log Admin Actions</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Create, update and delete of catalog, CMS, customers, sales documents, price rules, configuration, admin users and roles, plus mass actions and imports.</comment>
                    <depends><field id="enabled">1</field></depends>
                </field>
                <field id="log_logins" translate="label comment" type="select" sortOrder="30" showInDefault="1" canRestore="1">
                    <label>Log Admin Sign-ins</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Successful and failed sign-ins, lockouts, blocked IPs and sign-outs. Required for security notifications.</comment>
                    <depends><field id="enabled">1</field></depends>
                </field>
                <field id="ip_source" translate="label comment" type="select" sortOrder="35" showInDefault="1" canRestore="1">
                    <label>Client IP Address From</label>
                    <source_model>CommerceGears\ActivityLog\Model\Source\IpSource</source_model>
                    <comment><![CDATA[Used for the logs, alerts and IP allowlist. Default: Web server. Choose Cloudflare only if the logs show Cloudflare addresses; the <code>CF-Connecting-IP</code> header is then trusted on requests from Cloudflare's address ranges only.]]></comment>
                    <depends><field id="enabled">1</field></depends>
                </field>
                <field id="retention_days" translate="label comment" type="text" sortOrder="40" showInDefault="1" canRestore="1">
                    <label>Keep Log Entries For (Days)</label>
                    <validate>required-entry validate-digits validate-digits-range digits-range-0-3650</validate>
                    <comment>Default: 90. Older entries are deleted daily; 0 keeps everything; at most 3650 (ten years). Changes to these settings are always kept.</comment>
                    <depends><field id="enabled">1</field></depends>
                </field>
            </group>
            <group id="exclude" translate="label" sortOrder="20" showInDefault="1">
                <label>Exclusions</label>
                <depends><field id="commercegears_activitylog/general/enabled">1</field></depends>
                <field id="entity_types" translate="label comment" type="multiselect" sortOrder="10" showInDefault="1" canRestore="1">
                    <label>Do Not Log These Entities</label>
                    <source_model>CommerceGears\ActivityLog\Model\Source\EntityType</source_model>
                    <can_be_empty>1</can_be_empty>
                    <comment>Changes to the selected record types are not logged. Default: none, so everything is logged. Hold Ctrl (Cmd on a Mac) to select several.</comment>
                </field>
                <field id="config_paths" translate="label comment" type="textarea" sortOrder="20" showInDefault="1" canRestore="1">
                    <label>Do Not Log These Configuration Paths</label>
                    <comment><![CDATA[One path per line, <code>*</code> is a wildcard, for example <code>design/*</code>. Secret values such as passwords and API keys are always masked, so they do not need to be listed here.]]></comment>
                </field>
            </group>
            <group id="notifications" translate="label" sortOrder="30" showInDefault="1">
                <label>Security Notifications</label>
                <depends><field id="commercegears_activitylog/general/enabled">1</field></depends>
                <field id="enabled" translate="label comment" type="select" sortOrder="10" showInDefault="1" canRestore="1">
                    <label>Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Alerts for repeated failed sign-ins, lockouts and sign-ins from a new IP or country. Needs "Log Admin Sign-ins".</comment>
                </field>
                <field id="admin_notice" translate="label comment" type="select" sortOrder="20" showInDefault="1" canRestore="1">
                    <label>Add Admin Notification</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Shows the alert in the admin notification inbox (bell icon).</comment>
                    <depends><field id="enabled">1</field></depends>
                </field>
                <field id="recipients" translate="label comment" type="text" sortOrder="30" showInDefault="1">
                    <label>Email Recipients</label>
                    <validate>validate-emails</validate>
                    <comment>Comma-separated, for example security@example.com, it@example.com. Leave empty to send no emails.</comment>
                    <depends><field id="enabled">1</field></depends>
                </field>
                <field id="sender" translate="label comment" type="select" sortOrder="40" showInDefault="1" canRestore="1">
                    <label>Email Sender</label>
                    <comment>Store email address the alerts are sent from. Default: General Contact.</comment>
                    <source_model>Magento\Config\Model\Config\Source\Email\Identity</source_model>
                    <depends><field id="enabled">1</field></depends>
                </field>
                <field id="failed_threshold" translate="label comment" type="text" sortOrder="50" showInDefault="1" canRestore="1">
                    <label>Alert After Failed Sign-ins From One IP</label>
                    <validate>required-entry validate-digits validate-digits-range digits-range-1-1000</validate>
                    <comment>Default: 5; 1 to 1000. Lockouts of an admin account are always reported.</comment>
                    <depends><field id="enabled">1</field></depends>
                </field>
                <field id="failed_window" translate="label comment" type="text" sortOrder="60" showInDefault="1" canRestore="1">
                    <label>Within (Minutes)</label>
                    <validate>required-entry validate-digits validate-digits-range digits-range-1-1440</validate>
                    <comment>Default: 15; 1 to 1440 (one day).</comment>
                    <depends><field id="enabled">1</field></depends>
                </field>
                <field id="new_ip" translate="label comment" type="select" sortOrder="70" showInDefault="1" canRestore="1">
                    <label>Alert on Sign-in From a New IP</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>When an admin signs in from an IP address they have not used before.</comment>
                    <depends><field id="enabled">1</field></depends>
                </field>
                <field id="new_country" translate="label comment" type="select" sortOrder="80" showInDefault="1" canRestore="1">
                    <label>Alert on Sign-in From a New Country</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Uses the CF-IPCountry header, so it only works when the store is behind Cloudflare with IP geolocation on.</comment>
                    <depends><field id="enabled">1</field></depends>
                </field>
                <field id="notify_user" translate="label comment" type="select" sortOrder="90" showInDefault="1" canRestore="1">
                    <label>Also Email the Admin User</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Sends the new IP / new country alert to the admin account's own email address too.</comment>
                    <depends><field id="enabled">1</field></depends>
                </field>
                <field id="failed_template" translate="label comment" type="select" sortOrder="100" showInDefault="1" canRestore="1">
                    <label>Failed Sign-in Email Template</label>
                    <comment>Used for failed sign-in and lockout alerts. Copy it under Marketing > Email Templates to change the wording.</comment>
                    <source_model>Magento\Config\Model\Config\Source\Email\Template</source_model>
                    <depends><field id="enabled">1</field></depends>
                </field>
                <field id="new_ip_template" translate="label comment" type="select" sortOrder="110" showInDefault="1" canRestore="1">
                    <label>New IP / Country Email Template</label>
                    <comment>Used for sign-ins from a new IP address or country.</comment>
                    <source_model>Magento\Config\Model\Config\Source\Email\Template</source_model>
                    <depends><field id="enabled">1</field></depends>
                </field>
            </group>
            <group id="allowlist" translate="label comment" sortOrder="40" showInDefault="1">
                <label>Admin IP Allowlist</label>
                <comment><![CDATA[Only the listed IP addresses can use the admin panel. Locked out? Run <code>bin/magento commercegears:activity-log:allowlist --disable</code>.]]></comment>
                <depends><field id="commercegears_activitylog/general/enabled">1</field></depends>
                <field id="enabled" translate="label comment" type="select" sortOrder="10" showInDefault="1" canRestore="1">
                    <label>Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Default: No. Your own IP address must be on the list before it can be switched on.</comment>
                </field>
                <field id="ips" translate="label" type="textarea" sortOrder="20" showInDefault="1">
                    <label>Allowed IP Addresses</label>
                    <backend_model>CommerceGears\ActivityLog\Model\Config\Backend\Allowlist</backend_model>
                    <comment>
                        <model>CommerceGears\ActivityLog\Model\Config\Comment\AllowlistIps</model>
                    </comment>
                    <depends><field id="enabled">1</field></depends>
                </field>
            </group>
        </section>
    </system>
</config>
