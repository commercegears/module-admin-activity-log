<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Acl/etc/acl.xsd">
    <acl>
        <resources>
            <resource id="Magento_Backend::admin">
                <resource id="Softaware_Core::core">
                    <resource id="Softaware_ActivityLog::activity_log" title="Admin Activity Log" translate="title" sortOrder="40">
                        <resource id="Softaware_ActivityLog::actions" title="View Admin Actions" translate="title" sortOrder="10"/>
                        <resource id="Softaware_ActivityLog::logins" title="View Login Log" translate="title" sortOrder="20"/>
                        <resource id="Softaware_ActivityLog::sessions" title="Manage Active Sessions" translate="title" sortOrder="30"/>
                        <resource id="Softaware_ActivityLog::config" title="Settings" translate="title" sortOrder="40"/>
                    </resource>
                </resource>
            </resource>
        </resources>
    </acl>
</config>
